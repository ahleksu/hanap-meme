# Copy to .env.local (gitignored). Each teammate uses their OWN key.
# Without a key the app still runs: search uses keyword matching and ingest stores metadata only.

# Server-side only. Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=sk-your-key-here

# Optional model overrides. Defaults are listed in README "How OpenAI is used".
# OPENAI_TEXT_MODEL=gpt-6.1-sol
# OPENAI_EMBED_MODEL=text-embedding-3-small
# OPENAI_IMAGE_MODEL=gpt-image-2

# Public base URL used in MCP takedown links. Defaults to the request origin.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
